# Original game binaries and other redistributable inputs.
/bin/

# Machine-local direct-access paths and toolchain selection.  A profile from
# one checkout must never leak into another checkout or an SMB mount.
/.st-local/

# Expanded Ghidra working project. The verified packed checkpoint under
# ghidra/ is the portable Git/LFS representation.
/proj/

# macOS metadata.
.DS_Store
**/.DS_Store

# Ghidra project locks (created while a project is open).
*.lock
*.lock~

# Ghidra session/recovery artifacts. The expanded database itself is covered by
# the local /proj/ rule above; these patterns also protect nonstandard projects.
*.bak
*.tmp
*.temp
*.ps

# Local CodeBrowser/project UI state; analysis and annotations live in idata.
**/*.rep/projectState

# Common editor/patch leftovers.
*~
*.swp
*.swo

# Retained pipeline run logs are local diagnostics; canonical proposal/apply outputs stay tracked.
recovery/*/runs/
recovery/*/latest_run.txt

# Derived acceleration caches are local and can always be rebuilt.
recovery/*/analyzer_cache.tsv
recovery/*/program_semantic.sha256

# Transactional corpus-exporter staging/rollback directories. They normally
# exist only during STDecompExport, but may survive a killed Ghidra process.
decomp/.*.export-*/
decomp/.*.previous-*/
decomp/*/.function_analysis_cache.tsv

# Local Java/Ghidra script compilation output.
*.class
